{
  "name": "tienda-ordenadores-bootstrap",
  "version": "1.0.0",
  "description": "Practica 4 - Tienda de ordenadores con Bootstrap 5 y SASS",
  "private": true,
  "scripts": {
    "build:css": "sass --no-source-map --style=compressed --quiet-deps scss/main.scss css/style.css",
    "watch:css": "sass --no-source-map --watch --quiet-deps scss/main.scss css/style.css"
  },
  "devDependencies": {
    "bootstrap": "5.3.3",
    "sass": "1.77.6"
  }
}
